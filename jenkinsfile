pipeline{
    agent any
    stages{
        stage("pull"){
            steps{
              git branch: 'main', url: 'https://github.com/adityajadhav-dev/jenkins-pipeline.git'
            }
        }
        stage("build"){
            steps{
                echo("build successfull")
            }
        }
        stage("test"){
            steps{
                echo("test successfull")
            }
        }
        stage("deploy"){
            steps{
                echo("deploy successfull")
            }
        }
    }
}
